        "jsCode": "const { execSync } = require('child_process');\ntry {\n  const output = execSync('docker ps --format \"{{.Names}} - {{.Status}}\"').toString().trim();\n  const texto = output ? '🐳 Contenedores activos:\\n\\n' + output : '⚠️ No hay contenedores activos.';\n  return [{ json: { containers: texto, message: $input.first().json.message } }];\n} catch(e) {\n  return [{ json: { containers: '❌ Error al obtener contenedores.', message: $input.first().json.message } }];\n}"
      },
